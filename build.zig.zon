.{
    .name = .den,
    // Kept in step with package.json by bumpx on `bun run release:*`.
    // build.zig reads the binary's version from package.json, so the two must
    // not drift.
    .version = "0.2.2",
    .minimum_zig_version = "0.17.0-dev.956+2dca73595",
    .fingerprint = 0x21f6953b2c78079,
    // Everything `zig build` needs. package.json is embedded by build.zig for
    // the version string, and the default install step builds the test runner,
    // the benches and the examples — leaving any of them out breaks a plain
    // `zig build` for anyone consuming the published tarball.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "package.json",
        "src",
        "tests",
        "bench",
        "examples",
        "README.md",
        "LICENSE.md",
    },
}
